# Copy to .env and fill in. Never commit .env.

# --- core ---
APP_ENV=development                 # development | test | production (production refuses dev secrets)
SECRET_KEY=change-me-to-64-random-characters
JWT_SECRET=                         # optional, defaults to SECRET_KEY
DATABASE_URL=sqlite:///buspass.db   # postgresql://user:pass@host:5432/db in the cloud
PUBLIC_BASE_URL=http://localhost:5000
TIMEZONE=Africa/Cairo
CURRENCY=EGP
DEFAULT_LANGUAGE=en
DEMO_MODE=1                         # shows OTP codes on screen, seeds demo data, enables test checkout
COOKIE_SECURE=0                     # 1 behind HTTPS

# --- tokens & QR ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
QR_WINDOW_SECONDS=30
QR_ALLOWED_DRIFT_WINDOWS=1
ANTI_PASSBACK_MINUTES=10

# --- payments: mock | stripe | paymob | fawry ---
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# --- operations ---
RATELIMIT_STORAGE_URI=memory://     # redis://host:6379 when running several instances
LOG_LEVEL=INFO
UPLOAD_DIR=                         # defaults to ./instance/uploads (use object storage in production)
